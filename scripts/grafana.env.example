# cp scripts/grafana.env.example scripts/grafana.env
# Пароль SSH, пароль Grafana и токен записи в git не попадают.

GRAFANA_SSH_HOST=
GRAFANA_SSH_USER=root
GRAFANA_SSH_PORT=22
GRAFANA_SSH_PASSWORD=
GRAFANA_ADMIN_USER=admin
# Пустые пароль и токен скрипт сгенерирует сам и допишет в этот файл.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_WRITE_TOKEN=
# Домен с DNS на этот сервер включает обычный сертификат Let's Encrypt.
# Пусто — Grafana открывается по IP, сертификат свой.
GRAFANA_DOMAIN=
GRAFANA_ACME_EMAIL=admin@aegis-gate.ru

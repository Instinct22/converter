# Admin UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public URL used in subscription links shown in UI (must be reachable by phones)
# For a public deployment set the external HTTPS URL. Use HTTP for local development.
PUBLIC_BASE_URL=http://127.0.0.1:8080
UPDATE_BASE_URL=https://api.aegis-gate.ru
# Optional secret path, like 3x-ui: https://host/<SUB_PATH>/<subId>
# Empty = generated once and stored in the database
SUB_PATH=

# Bind
HOST=0.0.0.0
PORT=8080
